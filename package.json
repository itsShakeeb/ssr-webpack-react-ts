{
  "name": "ssr-react-webpack",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "build:client:dev": "cross-env NODE_ENV=development webpack --config webpack.client.dev.js",
    "build:client:prod": "cross-env NODE_ENV=production webpack --config webpack.client.prod.js",
    "build:server": "cross-env NODE_ENV=production webpack --config webpack.server.js",
    "build": "pnpm run build:client:prod && pnpm run build:server",
    "build:dev": "pnpm run build:client:dev && pnpm run build:server",
    "start": "node --experimental-specifier-resolution=node dist/server/server.js",
    "dev": "nodemon --watch src --ext ts,tsx --exec \"pnpm run build:dev && pnpm run start\"",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}' --quiet",
    "lint:fix": "eslint 'src/**/*.{ts,tsx,js,jsx}' --quiet --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,scss,json,md}'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky install"
  },
  "lint-staged": {
    "{*.js, *.tsx, *.ts}": [
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^5.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}